# Godot 4+ specific ignores
.godot/
/build/

# Keep the custom Android Gradle project
!android/build/
!android/build/**

# Ignore generated Gradle files
android/build/.gradle/
android/build/build/
android/build/.kotlin/

# Android Gradle project
android/build/libs/
android/build/src/main/assets/
android/build/src/instrumented/
android/build/src/androidTestInstrumented/

# Generated Android resources
android/build/res/*

# Preserve custom Android themes
!android/build/res/values/
android/build/res/values/*
!android/build/res/values/themes.xml